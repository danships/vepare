{
  "name": "initial-project",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @repo/web start",
    "lint": "pnpm -r --if-present lint",
    "lint:eslint": "pnpm -r --if-present lint:eslint",
    "lint:prettier": "pnpm -r --if-present lint:prettier",
    "lint:tsc": "pnpm -r --if-present lint:tsc",
    "format": "pnpm -r --if-present format",
    "ingest": "pnpm --filter @repo/media-ingest dev --",
    "test": "pnpm -r --if-present test"
  }
}
