{
  "name": "@repo/media-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "media-ingest": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && chmod +x dist/cli.js",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier && pnpm run lint:tsc",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier --check --log-level=warn src package.json tsconfig.json eslint.config.mjs README.md media-ingest.example.json",
    "lint:tsc": "tsc --noEmit",
    "format": "eslint --fix src && prettier --write src package.json tsconfig.json eslint.config.mjs README.md media-ingest.example.json",
    "test": "tsx --test src/__tests__/**/*.test.ts",
    "test:ffmpeg": "tsx --test src/__tests__/ffmpeg.integration.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "pino": "^10.3.1",
    "proper-lockfile": "^4.1.2",
    "supersave": "1.0.0-beta4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.9.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
